# OAS: instances are transient incarnations — souls are committed, instances never are.
agents/*/instances/
# Local souls (full souls, uncommitted by contract) — sibling of agents/
local-agents/
agents/local-agents/ # legacy nested location
agents/tmp-agents/   # legacy name

# aweb identity material (signing keys) — never committed, at any depth
.aw/

# Local machine preference: names the claude binary OAS launches for
# runtime: claude souls (account selection, e.g. "claude-personal") —
# personal config by contract, never committed (lib/core.mjs resolveClaudeBinary).
oas-claude-config

# OS noise
.DS_Store
node_modules/

# aweb workspace (keys, certs — never commit)
.aw/
packages/desktop/renderer/vendor/
packages/desktop/dist/
